COMPOSE_PROJECT_NAME=deka-staging
PUBLIC_DOMAIN=staging.example.com
ACME_EMAIL=operator@example.com
POSTGRES_PASSWORD=replace-with-unique-url-safe-password
SECRET_KEY=replace-with-random-secret-at-least-32-characters
MFA_ENCRYPTION_KEY=replace-with-independent-random-mfa-key-32-characters
BACKEND_IMAGE=deka-backend:release-candidate
FRONTEND_IMAGE=deka-frontend:release-candidate
BACKEND_ENV_FILE=./deploy/backend.staging.env
# Pin to the verified digest in the release manifest before rollout.
POSTGRES_IMAGE=deka-postgres:ready-184
PROXY_IMAGE=deka-proxy:ready-184

# Choose a different subnet/IP for each concurrent environment.
INTERNAL_SUBNET=172.30.184.0/24
PROXY_INTERNAL_IP=172.30.184.10
