FROM golang:1.26.6-alpine AS build
WORKDIR /src
COPY proxy/go.mod proxy/go.sum ./
COPY proxy/main.go ./
RUN --mount=type=tmpfs,target=/go/pkg/mod --mount=type=tmpfs,target=/root/.cache \
    CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/caddy .
FROM caddy:2.11.4-alpine
RUN apk upgrade --no-cache
COPY --from=build /out/caddy /usr/bin/caddy
