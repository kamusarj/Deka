[Unit]
Description=Export current Smart Exam authority and deletion evidence
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/smart-exam-ai
UMask=0077
ExecStart=/opt/smart-exam-ai/scripts/operations/export-journals.sh /etc/smart-exam/deployment.env /var/lib/smart-exam/journals --apply
# Connect unit failure alerts and encrypted off-host copying before pilot.
