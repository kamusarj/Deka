# New installations use the Deka project name. Keep your existing value when upgrading.
COMPOSE_PROJECT_NAME=deka
# Docker Compose only. Copy to .env and replace with a unique, URL-safe password.
POSTGRES_PASSWORD=REDACTED_OLD_POSTGRES_PASSWORD
# Required by the backend container in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_a_long_random_value
# Docker Compose truyền cùng giá trị này cho backend và frontend build.
MAX_UPLOAD_SIZE_BYTES=20971520
# Temporary demo role buttons on login; enable only for a demo/test stack.
VITE_ENABLE_DEMO_LOGIN=false
