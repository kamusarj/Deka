# ============================================================
# Deka — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── App ─────────────────────────────────────────────────
APP_NAME=Deka
ENV=development

# ── Database ────────────────────────────────────────────
# PostgreSQL (production / Docker)
DATABASE_URL=postgresql://smart_exam:REDACTED_OLD_POSTGRES_PASSWORD@postgres:5432/smart_exam_db
# Set to True to use PostgreSQL; False = auto SQLite fallback
USE_POSTGRES=True
DB_CONNECT_TIMEOUT_SECONDS=5

# ── Auth / JWT ──────────────────────────────────────────
# CHANGE THIS in production! Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ACCOUNT_TOKEN_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# ── AI Provider chain ───────────────────────────────────
# Fixed order: OpenAI (primary) -> Gemini -> DeepSeek.
# AI_PROVIDER is retained only for old deployments and must remain openai.
AI_PROVIDER=openai

# OpenAI primary — direct official Responses API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1
OPENAI_VERIFY_MODEL=
# Interactive full-exam generation is OpenAI-only and cost-optimized.
OPENAI_PRIMARY_ONLY_MODEL=gpt-5.6-luna
OPENAI_PRIMARY_ONLY_REASONING_EFFORT=low
OPENAI_PRIMARY_ONLY_VERBOSITY=low

# Gemini fallback 1 and mandatory interactive-exam reviewer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_VERIFY_MODEL=gemini-3.7-flash

# DeepSeek fallback 2 and mandatory interactive-exam reviewer
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_VERIFY_MODEL=deepseek-v4-pro

# Application ceiling for each provider request. Keeps the event loop free;
# verification falls back to a teacher-review status when it is exceeded.
AI_REQUEST_TIMEOUT_SECONDS=30
# Full sequential failover budget for up to three provider attempts.
AI_FAILOVER_TIMEOUT_SECONDS=90
# Interactive semantic review: dual (default) or temporary deepseek_only.
AI_INTERACTIVE_REVIEW_MODE=dual
# Per-reviewer ceiling for DeepSeek/Gemini reasoning calls.
AI_DUAL_REVIEW_TIMEOUT_SECONDS=90
# Transport timeouts handed to the provider SDK. Unlike the ceiling above these
# abort a request that has already started, releasing the worker thread.
# Keep AI_READ_TIMEOUT_SECONDS below AI_REQUEST_TIMEOUT_SECONDS so the SDK
# reports a real provider error instead of the outer wait cancelling it.
AI_CONNECT_TIMEOUT_SECONDS=10
AI_READ_TIMEOUT_SECONDS=25
# Retries inside the SDK. Each retry spends the same budget again.
AI_MAX_RETRIES=1
AI_GENERATION_BATCH_SIZE=4
AI_GENERATION_QUALITY_RETRIES=2
# One structured log line per provider call: latency, tokens, outcome.
AI_LOG_TELEMETRY=true

# ── RAG / ChromaDB ──────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8001
UPLOAD_DIR=app/data/uploads
# Maximum teacher-document size accepted by the API (20 MiB).
MAX_UPLOAD_SIZE_BYTES=20971520
RAG_TOP_K=5
RAG_CHUNK_SIZE=600
# Which retriever to build:
#   auto      – embeddings when GEMINI_API_KEY is set, otherwise BM25 (default)
#   bm25      – always offline BM25, never calls a provider
#   embedding – prefer embeddings; still falls back to BM25 if unavailable
RAG_RETRIEVER=auto
RAG_EMBEDDING_MODEL=gemini-embedding-001
# Cache chunk vectors so re-querying the same documents does not re-embed them.
# Leave false when RAG_RETRIEVER=bm25 — BM25 needs no vector store.
RAG_USE_CHROMA=false
# "http" uses the CHROMA_HOST/PORT service; anything else uses an embedded
# persistent client under CHROMA_PERSIST_DIR.
RAG_CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=app/data/chroma

# ── CORS ────────────────────────────────────────────────
# Frontend URLs allowed to call the API
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173"]

# ── Frontend URL (for OAuth redirect) ───────────────────
FRONTEND_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@deka.local
SMTP_USE_TLS=true

# ── OAuth: Google ───────────────────────────────────────
# Hướng dẫn lấy key:
# 1. Vào https://console.cloud.google.com/
# 2. Tạo project mới (hoặc chọn project có sẵn)
# 3. Vào APIs & Services → Library → tìm "Google+ API" → Enable
# 4. Vào APIs & Services → Credentials → Create Credentials → OAuth client ID
# 5. Application type: Web application
# 6. Authorized redirect URIs (thêm URI ứng với cách chạy của bạn):
#    Docker: http://localhost:8080/api/auth/callback/google
#    Local backend trực tiếp: http://localhost:8000/api/auth/callback/google
# 7. Copy Client ID và Client Secret vào đây
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: Facebook ─────────────────────────────────────
# Hướng dẫn lấy key:
# 1. Vào https://developers.facebook.com/
# 2. Click My Apps → Create App → chọn Consumer hoặc None
# 3. Đặt tên app → Create App
# 4. Vào Dashboard → add product "Facebook Login" → Settings
# 5. Valid OAuth Redirect URIs: thêm http://localhost:8000/api/auth/callback/facebook
# 6. Vào Settings → Basic → copy App ID và App Secret vào đây
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Hybrid retrieval: all providers remain optional. RAG_RETRIEVER=bm25 disables embeddings.
HYBRID_RETRIEVAL_ENABLED=true
LEXICAL_RETRIEVAL_ENABLED=true
VECTOR_RETRIEVAL_ENABLED=true
RERANKER_ENABLED=true
RAG_CANDIDATE_LIMIT=30
RAG_RRF_K=60
RAG_CONTEXT_TOKEN_BUDGET=2400
RAG_RERANK_LEXICAL_WEIGHT=0.65
# Exact bank duplicates reject insertion; fuzzy/semantic matches warn.
DUPLICATE_DETECTION_ENABLED=true
DUPLICATE_FUZZY_THRESHOLD=0.94
DUPLICATE_SEMANTIC_THRESHOLD=0.94
DUPLICATE_WARNING_THRESHOLD=0.86
DUPLICATE_CANDIDATE_LIMIT=30

# Native-first ingestion; auto uses configured Gemini, otherwise local Tesseract.
# Set none for native only; scan-only uploads then return a clear error.
OCR_PROVIDER=auto
OCR_MODEL=
OCR_TESSERACT_COMMAND=tesseract
OCR_LANGUAGES=vie+eng
OCR_PAGE_TIMEOUT_SECONDS=30
OCR_DOCUMENT_TIMEOUT_SECONDS=120
OCR_MAX_PAGES=12
OCR_MAX_OUTPUT_TOKENS=8192
OCR_NATIVE_MIN_CHARS=40
OCR_NATIVE_MIN_ALNUM_RATIO=0.4
OCR_RENDER_DPI=180
OCR_RENDER_MAX_SIDE=2400
OCR_MAX_IMAGE_PIXELS=16000000
DOCUMENT_MAX_PAGES=300
RAG_MEMORY_CACHE_SIZE=4096

RAG_EMBEDDING_BATCH_SIZE=64

# AI gateway: leave routing overrides blank to preserve current models/policy.
# A tier accepts a model name or provider:model (openai, gemini, deepseek).
AI_DEFAULT_PROVIDER=
AI_MODEL_FAST=
AI_MODEL_BALANCED=
AI_MODEL_PREMIUM=
ENABLE_CREDIT_SYSTEM=true
# Manual USD / 1,000,000 tokens. Empty means unknown cost (null), not zero.
# Example shape only: {"provider:model":{"input":"2","output":"8","cached_input":"1"}}
AI_MODEL_PRICING={}

# Deployment requires a separate MFA key; keep stable when rotating JWT signing.
MFA_ENCRYPTION_KEY=
