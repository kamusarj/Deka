# ===========================================
# Deka - Frontend Configuration
# ===========================================
# Copy this file to .env and update the values:
#   cp .env.example .env
# ===========================================

# Backend API URL. Để trống để dùng same-origin /api:
# - Vite dev proxy tới http://localhost:8000
# - Docker nginx proxy tới service backend
VITE_API_BASE_URL=
# Phải khớp MAX_UPLOAD_SIZE_BYTES của backend khi chạy riêng ngoài Compose.
VITE_MAX_UPLOAD_SIZE_BYTES=20971520
# Enable after explicitly provisioning the demo accounts (see README).
VITE_ENABLE_DEMO_LOGIN=false
